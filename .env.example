# AEDVIX Local Prototype Environment Configuration
# Copy this file to .env:
#   cp .env.example .env

# Local Prototype Administrator Authentication
# Set a private password for accessing the /admin dashboard
ADMIN_PASSWORD=

# A secure random secret string used to sign HttpOnly admin session cookies
ADMIN_SESSION_SECRET=

# Local Server Port (default: 4173)
PORT=4173

# Optional custom path to SQLite database (defaults to ./data/aedvix.db)
SQLITE_DB_PATH=./data/aedvix.db
